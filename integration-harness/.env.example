# Credentials are passed on the command line:
# --app-id, --token, --device-id

# Optional overrides.
WWW_BASE_URL=https://www.hxacc.com
LEARN_BASE_URL=https://learn.hxacc.com
VIDEO_BASE_URL=https://v1.hxacc.com
VIDEO_QUALITY=FD
VIDEO_MAX_RETRIES=5
APP_ID=60101caa0874ec17548b9822
HEARTBEAT_INTERVAL_SECONDS=60
VERIFY_POLL_INTERVAL_SECONDS=5
QR_PAGE_PORT=8000
RUNS_DIR=runs
RUN_START_HOUR=5
RUN_END_HOUR=22
MAX_PARALLEL_ACCOUNTS=3
AUTO_NEXT_COURSE=false
ACCOUNT_WATCH_INTERVAL_SECONDS=2
ACCOUNT_SLOT_COUNT=16
PROCESS_LEASE_SECONDS=120
WORKER_ID=device-01
WORKER_IDS=device-01
WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=de2d8b32-ca95-4117-b349-816feb0347d2
WECOM_NOTIFY_TAG=【integration-harness】
ACCOUNT_DIR=../account
OSS_ENDPOINT=https://oss-cn-shenzhen.aliyuncs.com
# Set false when the local network or proxy uses a certificate chain
# that Python's SSL stack cannot verify.
HXACC_SSL_VERIFY=false

# OSS directory/worker snapshots and status polling (0 disables each cache)
OSS_DIRECTORY_CACHE_SECONDS=60
OSS_WORKERS_CACHE_SECONDS=60
OSS_STOP_POLL_SECONDS=10
OSS_STATUS_POLL_SECONDS=60
