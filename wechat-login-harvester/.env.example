USER_FILE=user
ACCOUNT_DIR=../account
CAPTURE_PORT=8888
LOGIN_URL_MARKER=/index.php/api/user/wechatLogin
TOKEN_OUTPUT_DIR=runs/tokens
LEARN_BASE_URL=https://learn.hxacc.com
WATCH_INTERVAL_SECONDS=5
RELOGIN_POLL_INTERVAL_SECONDS=15
OSS_DIRECTORY_CACHE_SECONDS=60
LOGIN_LOGOUT_DELAY_SECONDS=30
# ui 保留原微信流程；web 对 login/harvest/watch 自动重登使用官网接口及本地 OCR
LOGIN_BACKEND=ui
# 必须选择账号报名地区对应的官网；广东南海账号已验证
WEB_LOGIN_BASE_URL=https://guangdong.hxacc.com
# 默认使用系统证书信任；仅自定义 CA 时填写 PEM 文件路径
WEB_LOGIN_CA_FILE=
# 金山表格新增检测：留空关闭，填写分享链接启用（先运行 kdocs-login）
KDOCS_URL=
KDOCS_PROFILE_DIR=runs/kdocs-browser
# 留空时自动选择唯一具有姓名、证件号、已同步、认证完成表头的工作表
KDOCS_SHEET=
KDOCS_POLL_SECONDS=5
WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=de2d8b32-ca95-4117-b349-816feb0347d2
WECOM_NOTIFY_TAG=【wechat-login-harvester】
WECOM_BOT_ID=your-bot-id
WECOM_BOT_SECRET=your-bot-secret
OSS_BUCKET=hxacc-auto
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_ENDPOINT=https://oss-cn-shenzhen.aliyuncs.com

# OSS 保留原有对象存储；Local 停用两端的 OSS 请求
STORAGE_MODE=OSS
SHARED_ROOT=/Users/fty/共享/hxacc
